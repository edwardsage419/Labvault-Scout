{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LabVault Scout scan report schema 1",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "provenance",
    "summary",
    "files",
    "errors",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "LabVault Scout"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "hash_algorithm",
        "path_style",
        "rules_sha256",
        "rules_count",
        "source_access"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "sha256"
        },
        "path_style": {
          "const": "relative-posix"
        },
        "rules_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rules_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_access": {
          "const": "read-only"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "file_count",
        "total_bytes",
        "inventory_sha256",
        "error_count",
        "risk_counts",
        "priority_counts",
        "open_copy_count",
        "duplicate_group_count"
      ],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "risk_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "priority_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "open_copy_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_group_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256",
          "format",
          "signature",
          "signature_status",
          "container_type",
          "risk",
          "confidence",
          "priority_score",
          "priority",
          "priority_reason",
          "recommended_action",
          "open_copy",
          "relationship_strength",
          "relationship_evidence",
          "evidence",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "pattern": "^/"
                }
              },
              {
                "not": {
                  "pattern": "\\\\"
                }
              },
              {
                "not": {
                  "pattern": "\\u0000"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "//"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)\\.(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "/$"
                }
              },
              {
                "not": {
                  "const": "."
                }
              }
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "format": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "signature_status": {
            "type": "string"
          },
          "container_type": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "SAFE",
              "WATCH",
              "RESCUE",
              "UNKNOWN"
            ]
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "priority_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "priority_reason": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "open_copy": {
            "type": "string"
          },
          "relationship_strength": {
            "type": "string"
          },
          "relationship_evidence": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "error"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "pattern": "^/"
                }
              },
              {
                "not": {
                  "pattern": "\\\\"
                }
              },
              {
                "not": {
                  "pattern": "\\u0000"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "//"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)\\.(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "/$"
                }
              }
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
