{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LabVault Scout bundle manifest schema 1",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "algorithm",
    "files",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "LabVault Scout"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "enum": [
              "scan.json",
              "files.csv",
              "duplicates.csv",
              "migration_plan.csv",
              "report.html"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
